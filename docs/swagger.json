{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "REST API backend for the university student dashboard.",
        "title": "Uni Dashboard API",
        "contact": {
            "name": "Anita Liberatore",
            "email": "anita.liberatore@studenti.unito.it"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
    "paths": {
        "/students/{studentId}": {
            "get": {
                "description": "Returns the complete profile for the given student",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "students"
                ],
                "summary": "Get student profile",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Student ID (e.g. S1234567)",
                        "name": "studentId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_liberatoreanita_uni-dashboard-be_internal_domain.Student"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/students/{studentId}/academic": {
            "get": {
                "description": "Returns GPA, credits, courses progress and degree details",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "students"
                ],
                "summary": "Get academic record",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Student ID (e.g. S1234567)",
                        "name": "studentId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_liberatoreanita_uni-dashboard-be_internal_domain.AcademicRecord"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/students/{studentId}/calendar": {
            "get": {
                "description": "Returns scheduled events (exams, deadlines, lectures) ordered by date asc",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "students"
                ],
                "summary": "Get calendar events",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Student ID (e.g. S1234567)",
                        "name": "studentId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/github_com_liberatoreanita_uni-dashboard-be_internal_domain.CalendarEvent"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/students/{studentId}/documents": {
            "get": {
                "description": "Returns all documents uploaded by the student",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "students"
                ],
                "summary": "List documents",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Student ID (e.g. S1234567)",
                        "name": "studentId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/github_com_liberatoreanita_uni-dashboard-be_internal_domain.Document"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/students/{studentId}/exams": {
            "get": {
                "description": "Returns the full list of exams passed by the student, ordered by date desc",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "exams"
                ],
                "summary": "List passed exams",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Student ID (e.g. S1234567)",
                        "name": "studentId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/github_com_liberatoreanita_uni-dashboard-be_internal_domain.Exam"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/students/{studentId}/exams/upcoming": {
            "get": {
                "description": "Returns exams the student is yet to sit, ordered by date asc",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "exams"
                ],
                "summary": "List upcoming exams",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Student ID (e.g. S1234567)",
                        "name": "studentId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/github_com_liberatoreanita_uni-dashboard-be_internal_domain.UpcomingExam"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/students/{studentId}/study-plan": {
            "get": {
                "description": "Returns the full study plan grouped by academic year",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "students"
                ],
                "summary": "Get study plan",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Student ID (e.g. S1234567)",
                        "name": "studentId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/github_com_liberatoreanita_uni-dashboard-be_internal_domain.YearPlan"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_adapters_http.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
